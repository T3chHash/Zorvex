{
    "name": "zorvex/network-bot",
    "description": "Zorvex | Network — Production-grade Telegram VPN management bot (Marzban / 3x-ui)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "keywords": ["telegram", "vpn", "bot", "marzban", "3x-ui", "payment"],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Zorvex\\": "src/"
        },
        "files": [
            "config/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zorvex\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/phpstan": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if(!file_exists('.env')) copy('.env.example', '.env');\""
        ],
        "lint": "find src config public migrations -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}