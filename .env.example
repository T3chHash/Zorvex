# =====================================================================
# Zorvex | Network — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ---------- App ----------
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran

# Your public URL WITHOUT trailing slash (used for webhooks / mini-app / callbacks)
APP_URL=https://zorvex.example.com

# Strong random 32+ char string (used for admin tokens, CSRF, etc.)
# Generate:  openssl rand -hex 32
APP_KEY=CHANGE_ME_openssl_rand_hex_32

# ---------- Database ----------
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=zorvex
DB_USERNAME=zorvex
DB_PASSWORD=zorvex_secret
DB_ROOT_PASSWORD=root_secret_change_me
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=60

# Run migrations on container start (1 = yes, 0 = no)
EXECUTE_MIGRATIONS=1

# ---------- Telegram ----------
# Get from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Comma separated numeric admin Telegram IDs
TELEGRAM_ADMIN_IDS=111111111,222222222

# Public support handle (without @)
TELEGRAM_SUPPORT_USERNAME=zorvex_support

# Allowed origins for the mini-app (comma separated). Used for extra context.
TELEGRAM_ALLOWED_ORIGINS=zorvex.example.com

# ---------- VPN Panels ----------
# Default panel type: marzban | 3x-ui
PANEL_DEFAULT_TYPE=marzban
PANEL_TIMEOUT=15
PANEL_RETRIES=3

# ---------- Payments: Crypto ----------
CRYPTO_NETWORK=TRC20
# Static wallet/address that receives payments (USDT on TRC20 by default)
CRYPTO_WALLET=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# How many Toman each USDT is worth
CRYPTO_USDT_RATE=82000
CRYPTO_MIN_CONFIRMATIONS=1

# ---------- Payments: Card-to-card ----------
CARD_TO_CARD_ENABLED=true
CARD_TO_CARD_NUMBER=6037-****-****-****
CARD_TO_CARD_HOLDER=Full Name
CARD_TO_CARD_AUTO_VERIFY=false

# ---------- Payments: Zarinpal ----------
ZARINPAL_ENABLED=true
# Set sandbox=false only after real settlement tests pass
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
# ZARINPAL_CALLBACK is auto-built from APP_URL

# ---------- Logging ----------
LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug   # debug | info | warning | error

# ---------- Docker ----------
# Host port for nginx
HTTP_PORT=8080
# Host port for the MySQL port-forward
DB_PORT_EXPOSED=3307